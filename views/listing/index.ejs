<% layout("/layouts/boilerplate") %>
            <h3 style="color: black; font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;">
                All Listing</h3>
            <!-- <form method="get" action="/listing/new">
            </form> -->

                <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-3">
                    <% for(let listing of allListing){ %>
                        <div class="col">
                            <a href="/listing/<%= listing._id %>" class="listing-link">
                                <div class="card" style= "width: 20rem";>
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 18rem">

                                    <div class="card-img-overlay">abcd</div>
                                    <div class="card-body">
                                        <p class="card-text">
                                            <b> <%= listing.title %> </b> <br>
                                            &#8377; <%= listing.price.toLocaleString("en-IN") %> /per night
                                        </p>
                                    </div>
                                </div>
                            </a>
                    </div>
                    <% } %>
                </div>
       


