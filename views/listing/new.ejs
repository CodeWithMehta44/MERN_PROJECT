<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create new listing </h3>
            <form method="post" action="/listing">
                <div class="mb-3">
                    <label for="list" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="Enter Title" type="text" class="form-control"> 
                </div>
                <br>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="Enter Description" rows="10" cols="40" class="form-control"></textarea>
                </div> 
                <br>  
                <div class="mb-3">
                    <label for="image" class="form-label">Image</label>
                    <input name="listing[image]" placeholder="Enter Image URL" type="text" class="form-control">
                </div> 
                <br> 
               
                <div class="row">
                    <div class="mb-3 col-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" placeholder="Enter Country" type="text" class="form-control"> 
                    </div>
                    <br> 
                     <div class="mb-3 col-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="Enter Price" type="number" class="form-control"> 
                </div>
                </div>
                <br>
                 <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" placeholder="Enter Location" type="text" class="form-control"> 
                </div>
                <br>
                <button class="btn btn-dark add-btn">Add</button>
            </form>
     </div>
</div>