<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2 mt-3" >
    <h3 style="color: black; font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;">Edit Your Listing </h3>
    <form method="post" action="/listing/<%= listing._id %>?_method=PUT">
        <div class="mb-3">
            <label for="list" class="form-label">Title</label>
            <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control"> 
        </div>
        <br>
        <div class="mb-2">
            <label for="decription" class="form-label">Description</label>
            <textarea name="listing[description]" rows="5" cols="40" class="form-control"><%= listing.description %></textarea> <br>
        </div>
        
        <div class="mb-2">
            <label for="image" class="form-label">Image</label>
            <input name="listing[image]" value="<%= listing.image %>" type="text" class="form-control"> <br>
        </div>
        <div class="row">
        <div class="mb-2 col-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control"> <br>
        </div>
        <div class="mb-2 col-8">
            <label for="country" class="form-label">Counytry</label>
            <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control"> <br>
        </div>
        </div>

        <div class="mb-2">
            <label for="title" class="form-label">Location</label>
            <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control"> <br>
        </div>
        
        <button class="btn btn-dark edit-btn">Edit</button>
    </form>
    </div>
</div>
