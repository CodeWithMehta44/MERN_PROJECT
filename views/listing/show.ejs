<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-7 offset-3">
    <h3 style="color: black; font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;">Listing Details: </h3>

    <div class="card col-20">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text" style="text-align: center;">
               <b> <%= listing.title %> </b><br>
               <%= listing.description %> <br>
               <%= listing.location %> <br>
               <%= listing.country %> <br>
                &#8377; <%= listing.price.toLocaleString("en-IN") %>
            </p>
        </div>
    </div>
    <a href="/listing/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
    <form method="post" action="/listing/<%= listing._id %>/?_method=DELETE ">
        <button class="btn btn-dark mt-3">Delete The Listing</button>
    </form>
    </div>
</div>

